# Kopie als .env anlegen und anpassen:  cp .env.example .env
# Die Datei gehört NICHT ins Git — .gitignore kennt sie schon.

# Deine bestehende Domain (ohne https:// und ohne Pfad)
DOMAIN=deine-domain.ddns.net

# Unterpfad, unter dem das Casino läuft
BASE_PATH=/gamba

# Name des certresolvers aus deiner Traefik-Konfiguration
CERT_RESOLVER=letsencrypt

# Admin-PIN beim allerersten Start (danach im Admin-Panel änderbar)
GAMBAKING_PIN=1337

TZ=Europe/Berlin
